# Copy to .env and adjust as needed. All values below are the defaults.

# App
APP_NAME=Aegis Resource Advisor
PLATFORM_ENVIRONMENT=student-laptop

# Frontend origins allowed by CORS
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_API_BASE_URL=http://127.0.0.1:8000

# Telemetry sampling (built-in sampler feeds the dashboard with live data)
ENABLE_LOCAL_SAMPLER=true
SAMPLER_INTERVAL_SECONDS=4
COLLECT_TOP_PROCESSES=true
TOP_PROCESS_LIMIT=8

# Prediction / history
PREDICTION_WINDOW=48
DASHBOARD_HISTORY_LIMIT=36

# Remediation safety (kept conservative by default)
DEMO_MODE=true
AUTO_REMEDIATION_ENABLED=false
ALLOW_LIVE_REMEDIATION=false
REMEDIATION_DEFAULT_MODE=simulate
